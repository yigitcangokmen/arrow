# Arrow environment variables. Copy to .env (gitignored) and fill in locally.
# NEVER commit real values, including testnet keys. Deploy/full-access keys stay in the near-cli-rs keychain, not here.
# Hosted (Vercel) values are set in the Vercel dashboard, not in git.

# ---------- Network ----------
# testnet | mainnet (scripts and web default network)
ARROW_NETWORK=testnet

# NEAR RPC (public, free; verified 2026-11-09)
MAINNET_RPC_URL=https://rpc.mainnet.fastnear.com
TESTNET_RPC_URL=https://rpc.testnet.fastnear.com
# Archival RPC: needed by `verify` for txs older than ~2-3 days (verified on both networks 2026-11-09)
MAINNET_ARCHIVAL_RPC_URL=https://archival-rpc.mainnet.fastnear.com
TESTNET_ARCHIVAL_RPC_URL=https://archival-rpc.testnet.fastnear.com
# Base RPC for the ERC-20 transfer to the 1Click deposit address (scripts only)
BASE_RPC_URL=https://mainnet.base.org

# ---------- Arrow accounts ----------
ARROW_CONTRACT_MAINNET=arrow-market.near
ARROW_CONTRACT_TESTNET=arrow-v2.arrowhq.testnet
ARROW_USD_TESTNET=arrow-usd.arrowhq.testnet
# Testnet treasury: arrowhq.testnet
TREASURY_ACCOUNT_ID=arrowhq.near

# ---------- OutLayer ----------
OUTLAYER_CONTRACT_MAINNET=outlayer.near
OUTLAYER_CONTRACT_TESTNET=outlayer.testnet
OUTLAYER_API_MAINNET=https://api.outlayer.ai
OUTLAYER_API_TESTNET=https://testnet-api.outlayer.ai
# Frozen enclave wasm (public HTTPS URL + lowercase 64-hex sha256). Set at freeze (2026-11-12 18:00 GMT+7).
PROGRAM_WASM_URL=
PROGRAM_WASM_SHA256=
# secrets_ref profile used with `outlayer secrets set` (PROTECTED_MASTER + NEARAI_API_KEY live inside OutLayer, not here)
OUTLAYER_SECRETS_PROFILE=arrow

# ---------- NEAR Intents / 1Click ----------
INTENTS_CONTRACT=intents.near
USDC_TOKEN_ID=nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
BASE_USDC_ASSET_ID=nep141:base-0x833589fcd6edb6e08f4c7c32d4f71b54bda02913.omft.near
SOL_USDC_ASSET_ID=nep141:sol-5ce3bf3a31af18be40ba30f721101b4341690186.omft.near
ONECLICK_API_BASE=https://1click.chaindefuser.com
# Optional JWT from partners.near-intents.org; without it 1Click charges a 0.2% fee (HACKATHON.md Q-006)
ONECLICK_JWT=

# ---------- NEAR AI ----------
NEARAI_API_BASE=https://cloud-api.near.ai/v1
NEARAI_MODEL=Qwen/Qwen3.8-27B
NEARAI_FALLBACK_MODEL=z-ai/glm-5.3-flash
# Used ONLY by bench direct calls (naive / LLM-only baselines, replay). The enclave's copy is stored as an OutLayer secret.
# Never expose to the browser (no NEXT_PUBLIC_ prefix).
NEARAI_API_KEY=
# Mainnet OutLayer secret copy. It is the same free NEAR Builders hackathon key as NEARAI_API_KEY above (nearbuilders.org/dashboard): it cannot be topped up and its expiry is not published; if it runs out, evals refund by design. Testnet and bench traffic share its credit and rate limit.
NEARAI_API_KEY_MAINNET=
# Testnet account that runs bench:live (its key is read from ~/.near-credentials/testnet, not from here). Not a secret.
BENCH_ACCOUNT_ID=bench.arrowhq.testnet

# ---------- Relayer (server only: web /api/relay, scripts) ----------
# Gas-only account. Its key is a FunctionCall key limited to receiver intents.near, method execute_intents,
# added with UNLIMITED allowance (red-team B4). Holds only gas money.
RELAYER_ACCOUNT_ID=arrow-relayer.arrowhq.near
RELAYER_PRIVATE_KEY=
RELAYER_RATE_LIMIT_PER_IP_PER_MIN=10
# Testnet relayer account for scripts (direct relay mode)
RELAYER_TESTNET_ACCOUNT_ID=
# Only if K0 picks the Escrow path (H-07b): second relayer key limited to the market contract
RELAYER_ESCROW_PRIVATE_KEY=

# ---------- CLI / MCP (agent) ----------
# Hosted relay base URL; default is https://$NEXT_PUBLIC_SITE_DOMAIN/api/relay
ARROW_RELAY_URL=
# MCP spend guard: mainnet tools stay disabled unless this is 1; per-call cap in USDC
ARROW_MCP_ALLOW_MAINNET=
ARROW_MCP_MAX_USDC=1.00

# ---------- Hosted testnet sponsor (server only: web /api/testnet-sponsor) ----------
# Testnet account that creates and funds judge sub-accounts (<random>.arrow-judge.arrowhq.testnet). Testnet only.
TESTNET_SPONSOR_ACCOUNT_ID=arrow-judge.arrowhq.testnet
TESTNET_SPONSOR_PRIVATE_KEY=
TESTNET_SPONSOR_NEAR_PER_ACCOUNT=0.5

# ---------- Blob storage (server only: web /api/blob) ----------
# Vercel Blob read-write token; ciphertext only, host is untrusted (sha256 on chain)
BLOB_READ_WRITE_TOKEN=
# Vercel cron auth for /api/cron/blob-gc (server only); Vercel sends it as a Bearer token
CRON_SECRET=

# ---------- E2E scripts (mainnet test wallets with small funds; never real treasuries) ----------
# EVM test wallets used by scripts/e2e-mainnet.ts and spikes (buyer pays from Base, seller lists)
E2E_BUYER_EVM_PRIVATE_KEY=
E2E_SELLER_EVM_PRIVATE_KEY=
# Solana address that receives the 1Click outbound in the demo
SOLANA_PAYOUT_ADDRESS=

# ---------- Web (public, safe to expose) ----------
NEXT_PUBLIC_ARROW_NETWORK=mainnet
NEXT_PUBLIC_ARROW_CONTRACT_MAINNET=arrow-market.near
NEXT_PUBLIC_ARROW_CONTRACT_TESTNET=arrow-v2.arrowhq.testnet
# Hosted domain, also embedded in the viewing-key message (red-team §5 fix)
# Set after the first Vercel deploy; frozen from 2026-11-13 12:00 GMT+7.
NEXT_PUBLIC_SITE_DOMAIN=
