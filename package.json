{
  "name": "arrow",
  "version": "0.1.0",
  "private": true,
  "description": "Arrow: inspect-before-pay data market on NEAR (OutLayer TDX + NEAR AI + NEAR Intents)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "workspaces": [
    "sdk",
    "web",
    "agent",
    "scripts",
    "bench"
  ],
  "scripts": {
    "arrow": "tsx agent/src/cli.ts",
    "verify": "tsx scripts/src/verify.ts",
    "check:judges": "tsx scripts/src/check-judges.ts",
    "try:testnet": "tsx scripts/src/try-testnet.ts",
    "replay": "tsx scripts/src/replay.ts",
    "md2jsonl": "tsx scripts/src/md-to-jsonl.ts",
    "bench:gen": "tsx bench/src/gen/index.ts",
    "bench:prepare": "tsx bench/src/prepare.ts",
    "bench:baselines": "tsx bench/src/baselines.ts",
    "bench:native": "tsx bench/src/native.ts",
    "bench:offline": "tsx bench/src/offline.ts",
    "bench:live": "tsx bench/src/live.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit -p tsconfig.json",
    "check": "bash scripts/check-all.sh"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
